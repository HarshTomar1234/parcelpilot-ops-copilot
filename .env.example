# Path to the assessment source pack. NOT committed - supply your own copy.
# Expected to contain the 6 PDFs and ParcelPilot_Assessment_Data.xlsx.
PARCELPILOT_SOURCE_DIR=D:\AI-Projects\parcelpilot-assessment\source-pack

# LLM gateway (app/llm/, ADR-017). Optional: everything defaults to
# MockProvider (deterministic, free, no network) when unset - real scores
# from scripts/run_deepeval_baseline.py require this to be set.
ANTHROPIC_API_KEY=

# Set automatically by tests/conftest.py; set it yourself when running
# scripts/run_deepeval_baseline.py directly to avoid DeepEval's background
# analytics network calls.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Business calendar assumption (ADR-007). The source pack never defines these.
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
